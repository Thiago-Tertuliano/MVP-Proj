meta {
  name: 06 Trilha Dados
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/trilhas/dados
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.slug: eq dados
}

docs {
  Verifica se a trilha dinâmica extraída do cabeçalho "## Dados" foi registrada.
}