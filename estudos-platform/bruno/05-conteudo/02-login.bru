meta {
  name: 02 Login Seed
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "autor.seed@estudos.local",
    "senha": "senha1234"
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.tokens) {
    bru.setEnvVar("accessToken", body.tokens.access_token);
    bru.setEnvVar("refreshToken", body.tokens.refresh_token);
    bru.setEnvVar("usuarioId", body.usuario.id);
  }
}

assert {
  res.status: eq 200
}

docs {
  Autentica com o usuário da migration (Seed 0004) para permitir as publicações seguintes.
}