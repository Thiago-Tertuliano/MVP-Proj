meta {
  name: 07 Publicar Demo
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/artigos/{{demoArtigoId}}/publicar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.status: eq publicado
}

docs {
  Publica pela API o artigo pacotes-em-go salvo no request 04.
}