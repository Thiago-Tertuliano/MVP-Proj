meta {
  name: Publicar Trilha
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/trilhas/{{trilhaId}}/publicar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
}

docs {
  Publica a trilha. Depois disso ela aparece no Listar / Obter por slug.
}
