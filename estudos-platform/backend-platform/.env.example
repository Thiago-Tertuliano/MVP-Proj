APP_ENV=development
# Sem APP_PORT, usa PORT (injetada pelo Render) e depois 8080.
APP_PORT=8080

# (Produção) URL completa do Postgres, ex.: a connection string do Neon.
# Quando definida, tem prioridade sobre DB_*.
# DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

# (Produção atrás de proxy, ex.: Render) Rate limit usa o IP do X-Forwarded-For.
# TRUST_PROXY=true

DB_HOST=localhost
DB_PORT=5433
DB_USER=estudos
DB_PASSWORD=estudos_dev
DB_NAME=estudos_platform
DB_SSL_MODE=disable

# Em APP_ENV=production precisa ter pelo menos 32 caracteres.
JWT_SECRET=troque-este-segredo-em-producao
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_HOURS=168

# Origens permitidas (CSV). Use * apenas em desenvolvimento.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# E-mails (CSV) com permissão de editor: criam/editam roadmaps. Promovidos no primeiro acesso.
EDITOR_EMAILS=autor.seed@estudos.local

# Seed de demo (migration 0004): autor.seed@estudos.local / senha1234
# Embedding: sem chave a busca usa ILIKE no título.
# OPENAI_API_KEY=